{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "eventId",
    "eventType",
    "occurredAt",
    "ingestedAt",
    "subjectMemberId",
    "targetMemberId",
    "correlationId",
    "payload"
  ],
  "$id": "urn:pymk:member-events:v1",
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "const": 1
    },
    "eventId": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "eventType": {
      "enum": [
        "PROFILE_VIEW",
        "SEARCH_APPEARANCE",
        "INVITE_SENT",
        "INVITE_ACCEPTED",
        "INVITE_IGNORED"
      ]
    },
    "occurredAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-5][0-9](\\.[0-9]{1,9})?Z$"
    },
    "ingestedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-5][0-9](\\.[0-9]{1,9})?Z$"
    },
    "subjectMemberId": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9223372036854775807
    },
    "targetMemberId": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9223372036854775807
    },
    "correlationId": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "maxProperties": 0
    }
  }
}
